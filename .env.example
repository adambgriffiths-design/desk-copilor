OPENAI_API_KEY=sk-your-key-here

# Optional — shown in DEPLOY.md for hosted backend setup.
# Extension API URL is set in Chrome extension Options (chrome.storage.sync.apiBaseUrl).

# Pause rule updates (optional).
# LEARN_FROZEN=true

# Backtest wrong rows in learning (optional, higher overfit risk).
# LEARN_INCLUDE_BACKTEST_WRONG=true

# Backtest miss rows — under-calling (default: included).
# LEARN_INCLUDE_BACKTEST_MISSES=false
