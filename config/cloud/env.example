# Karen cloud env example (Phase 1 prep)
# Copy values into a secret manager (1Password / Doppler) or a local
# gitignored file pointed at by KAREN_ENV_FILE. Never commit real secrets.
#
# Portable path overrides (optional):
# KAREN_REPO_ROOT=
# KAREN_DATA_ROOT=
# KAREN_CACHE_ROOT=
# KAREN_DV_CHECKPOINT_ROOT=
# KAREN_ENV_FILE=

# TickStream (ingest machine / expand jobs)
TICKSTREAM_API_KEY=
TICKSTREAM_API_URL=

# App (chat / voice) — not required for offline DV replay once bars exist
OPENAI_API_KEY=

# Cloudflare R2 (S3-compatible) — names only; inject at runtime
KAREN_R2_ACCOUNT_ID=
KAREN_R2_BUCKET=karen-nq-history
KAREN_R2_ENDPOINT=
KAREN_R2_ACCESS_KEY_ID=
KAREN_R2_SECRET_ACCESS_KEY=
KAREN_R2_REGION=auto

# Optional path to local R2 config override (gitignored)
# KAREN_R2_CONFIG=config/cloud/r2.local.json

# Remote DV worker (laptop SSH monitor)
# KAREN_VM_IP=
# KAREN_VM_USER=karen

# Holdout unlock (default unset / sealed) — never set on holiday DEV laptop/VM
# KAREN_HOLDOUT_UNLOCK=1
