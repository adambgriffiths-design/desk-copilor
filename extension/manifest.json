{
  "manifest_version": 3,
  "name": "The Trading Desk",
  "version": "1.4.60",
  "description": "No signals. Just the read. ICT desk on TradingView.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "https://desk-copilor.vercel.app/*",
    "https://*.vercel.app/*",
    "https://api.openai.com/*",
    "https://www.tradingview.com/*",
    "https://*.tradingview.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "The Trading Desk — get verdict",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["tv-bridge.js", "desk-tracker.css"],
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["tv-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["plain-language.js", "desk-persona.js", "session-context.js", "connection-state.js", "request-trace.js", "weather-local.js", "casual-chat.js", "pending-request.js", "transcription-guard.js", "chart-intent.js", "desk-route-intent.js", "voice-context-fix.js", "voice-interpret.js", "voice-emotion.js", "voice-quick-reply.js", "voice-spoken-sanitize.js", "voice-latency.js", "voice-realtime.js", "voice.js", "desk-memory.js", "level-toggles.js", "chart-draw.js", "chart-price.js", "chart-snapshot.js", "desk-ui-components.js", "desk-mock-analysis.js", "desk-verdict-ui.js", "desk-tracker.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
