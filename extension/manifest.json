{
  "manifest_version": 3,
  "name": "The Trading Desk",
  "version": "1.0.43",
  "description": "No signals. Just the read. ICT desk on TradingView.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "https://desk-copilor.vercel.app/*",
    "https://*.vercel.app/*",
    "https://api.openai.com/*",
    "https://www.tradingview.com/*",
    "https://*.tradingview.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "The Trading Desk — get verdict",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["tv-bridge.js"],
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["tv-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["chart-intent.js", "voice-realtime.js", "voice.js", "chart-draw.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
